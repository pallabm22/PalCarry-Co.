<%- include('./partials/header') %>

<div class="w-full min-h-screen flex px-20 py-20 gap-10">
  <!-- Left side: Cart Items -->
  <div class="w-[30%]">
    <% if (products && products.length > 0) { %> <%
    products.forEach(function(item, index) { const product = item.productId;
    const qty = item.quantity; const discountedPrice = product.price -
    (product.price * product.discount / 100); const netPrice = discountedPrice *
    qty; %>
    <div class="rounded-md overflow-hidden mb-8 border border-gray-300">
      <div class="w-full h-80 bg-yellow-500 flex items-center justify-center">
        <% if (product.image) { %>
        <img
          src="data:image/png;base64,<%= product.image.toString('base64') %>"
          class="h-full w-full object-cover"
        />
        <% } else { %>
        <span class="text-white">No Image</span>
        <% } %>
      </div>
      <div class="w-full flex justify-between px-5 py-4">
        <h3 class="text-2xl"><%= product.name %></h3>
        <div class="flex items-center gap-2">
          <i
            class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-add-line"
          ></i>
          <div class="px-2 py-1 rounded-md bg-white text-black"><%= qty %></div>
          <i
            class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-subtract-line"
          ></i>
        </div>
      </div>
      <div class="flex items-center justify-between px-5 py-3">
        <h4 class="text-lg">Net Total</h4>
        <h2 class="text-lg">₹ <%= netPrice %></h2>
      </div>
    </div>
    <% }) %> <% } else { %>
    <h2 class="text-xl text-gray-500">Your cart is empty</h2>
    <% } %>
  </div>

  <!-- Right side: Price Breakdown -->
  <div class="w-[70%]">
    <h3 class="text-xl">Price Breakdown</h3>
    <div class="px-10 mt-5">
      <% let totalMRP = 0; let totalDiscount = 0; let totalAmount = 0; if
      (products && products.length > 0) { products.forEach(item => { const
      product = item.productId; const qty = item.quantity; totalMRP +=
      product.price * qty; totalDiscount += (product.price * product.discount /
      100) * qty; totalAmount += (product.price - (product.price *
      product.discount / 100)) * qty; }); } %>

      <div class="flex mt-2">
        <h4 class="w-1/3">Total MRP</h4>
        <h4>₹ <%= totalMRP %></h4>
      </div>
      <div class="flex mt-2">
        <h4 class="w-1/3">Discount on MRP</h4>
        <h4>- ₹ <%= totalDiscount %></h4>
      </div>
      <div class="flex mt-2">
        <h4 class="w-1/3">Platform Fee</h4>
        <h4>₹ 20</h4>
      </div>
      <div class="flex mt-2">
        <h4 class="w-1/3">Shipping Fee</h4>
        <h4>FREE</h4>
      </div>
    </div>

    <div class="w-full h-[1px] bg-black mt-10"></div>
    <div class="flex mt-5">
      <h3 class="w-1/3 text-xl">Total Amount</h3>
      <h3 class="font-semibold text-xl text-green-600">
        ₹ <%= totalAmount + 20 %>
        <!-- Platform fee added -->
      </h3>
    </div>
    <form action="" method="post">
      <button
        type="submit"
        class="mt-5 px-5 py-2 bg-green-600 text-white rounded-md"
      >
        Checkout
      </button>
    </form>
  </div>
</div>

<%- include('./partials/footer') %>
